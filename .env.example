# Good Times in Cape Town: website build and enquiry system
# Copy to .env for local development. Never commit .env, and never put real secrets in this file.
# Deployed (Cloudflare Pages, the Good Times account): the plain values per environment live in
# scripts/cloudflare/project.mjs and reach both the build and the Functions; the three secrets
# (DATABASE_URL, RESEND_API_KEY, ENQUIRY_SIGNING_SECRET) are set in the Pages project's settings,
# never in a file. See README.md › Deployment and docs/APPROVAL_REGISTER.md.

# ---- Build -----------------------------------------------------------------
SITE_ENV=preview                 # preview (default): noindex, preview banner, unconfirmed contacts shown as "awaiting confirmation". production: indexable site.
SHOW_INDICATIVE_PRICES=true      # false hides the published "from" prices (src/data/tours.mjs)
LINK_STYLE=pretty                # pretty (clean URLs) or files (explicit index.html links, for hosts without directory indexes)

# ---- Enquiries: the two switches -------------------------------------------
# ENQUIRY_SYSTEM_ENABLED=false  → the page shows a "paused" notice instead of the form, and the API returns 503.
ENQUIRY_SYSTEM_ENABLED=true
# ENQUIRY_MODE is read at build time AND by the API:
#   preview (default) → the wizard works end to end (validation, review) but never sends; it says so plainly.
#                       The API also refuses enquiries (503), so a preview deployment needs none of the settings below.
#   live              → the wizard posts to /api/enquiries and shows the GT- reference only after a real 201.
#                       Requires the database, email and secrets below. Switch on only when Good Times has approved.
ENQUIRY_MODE=preview

# ---- Email (required when ENQUIRY_MODE=live) --------------------------------
# file   → local dev and tests: writes each message as an .eml into data/outbox/. Nothing leaves the machine.
# resend → production: sends through the Resend API.
EMAIL_PROVIDER=file
RESEND_API_KEY=                  # required when EMAIL_PROVIDER=resend
FROM_EMAIL=                      # a sender on a domain verified in Resend, e.g. "Good Times in Cape Town <info@goodtimesincapetown.co.za>"
ENQUIRY_TEAM_EMAIL=              # the Good Times inbox that receives every new enquiry (reply-to is set to the visitor)
REPLY_TO_EMAIL=                  # where visitors' replies to the acknowledgement go (a Good Times inbox)

# ---- Database (required when ENQUIRY_MODE=live) -----------------------------
# Production: a Postgres connection string (postgres://…?sslmode=require), e.g. from Neon.
# Local dev / tests: pglite://data/dev.pglite (a local folder) or pglite://memory (throwaway).
DATABASE_URL=pglite://data/dev.pglite

# ---- Secrets (required when ENQUIRY_MODE=live) ------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENQUIRY_SIGNING_SECRET=          # at least 32 characters. Signs the status links in the team email; also keys the IP hashes.

# ---- Site and limits ---------------------------------------------------------
PUBLIC_SITE_URL=http://127.0.0.1:8080   # absolute origin used in emails, status links and canonical URLs; no trailing slash
RATE_LIMIT_PER_MINUTE=10                # enquiries accepted per minute from one IP address

# ---- Staff bookings dashboard (/admin/) --------------------------------------
# Comma-separated staff addresses that may sign in with an emailed link. Empty: sign-in is off.
ADMIN_EMAILS=

# ---- Local tests only (refused in production) ----------------------------------
# Point the production drivers at stand-ins (test/helpers/neon-standin.mjs, resend-standin.mjs).
# DATABASE_HTTP_ENDPOINT=http://127.0.0.1:4444/sql
# RESEND_API_URL=http://127.0.0.1:5555/emails
